generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MODERATOR
  SELLER
}

enum PurchaseOrderStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE_RECEPTION
  SALE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  SALE_CANCELLATION
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SELLER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdPurchaseOrders PurchaseOrder[]
  sales                 Sale[]
  stockMovements        StockMovement[]
  stockTransfers        StockTransfer[]
  payments              Payment[]
  cancelledSales        Sale[]          @relation("SaleCancelledBy")
  openedCashSessions    CashSession[]   @relation("CashSessionOpenedBy")
  closedCashSessions    CashSession[]   @relation("CashSessionClosedBy")
}

// Emplacement / point de vente physique. Le catalogue (produits, catégories,
// fournisseurs, clients) reste partagé entre emplacements ; seul le stock
// (ProductStock) est propre à chacun.
model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stocks         ProductStock[]
  purchaseOrders PurchaseOrder[]
  sales          Sale[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  batches        ProductBatch[]
  cashSessions   CashSession[]
}

// Session de caisse : montant d'ouverture déclaré par un vendeur, comparé au
// montant compté à la clôture pour détecter tout écart (uniquement les
// paiements en espèces comptent dans le montant théorique).
model CashSession {
  id             String    @id @default(cuid())
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id])
  openingAmount  Decimal   @db.Decimal(10, 2)
  openedById     String
  openedBy       User      @relation("CashSessionOpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime  @default(now())
  expectedAmount Decimal?  @db.Decimal(10, 2)
  otherAmount    Decimal?  @db.Decimal(10, 2)
  countedAmount  Decimal?  @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2)
  note           String?
  closedById     String?
  closedBy       User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id])
  closedAt       DateTime?
}

model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  symbol    String?
  createdAt DateTime  @default(now())
  products  Product[]
  productSellUnits ProductSellUnit[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime   @default(now())
  products    Product[]

  @@unique([parentId, name])
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactName   String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model Product {
  id             String              @id @default(cuid())
  name           String
  sku            String?             @unique
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  unitId         String
  unit           Unit                @relation(fields: [unitId], references: [id])
  purchasePrice  Decimal             @db.Decimal(10, 2)
  sellingPrice   Decimal             @db.Decimal(10, 2)
  alertThreshold Int                 @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  purchaseOrderItems PurchaseOrderItem[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  sellUnits          ProductSellUnit[]
  stocks             ProductStock[]
  stockTransfers     StockTransfer[]
  batches            ProductBatch[]
}

// Lot reçu à une date de péremption donnée, à un emplacement donné. Permet le
// suivi FEFO (first-expire-first-out) : les ventes/sorties de stock consomment
// en priorité les lots dont la péremption est la plus proche.
model ProductBatch {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  expiryDate        DateTime?
  quantityRemaining Int
  createdAt         DateTime  @default(now())

  stockMovements StockMovement[]
}

// Quantité en stock d'un produit à un emplacement donné (unité de stock du produit).
model ProductStock {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int      @default(0)

  @@unique([productId, locationId])
}

// Unité de vente alternative (ex. "Boîte de 10" pour un produit dont le stock
// est suivi en comprimés) : conversionFactor = quantité en unité de stock du
// produit correspondant à 1 de cette unité de vente, avec son propre prix.
model ProductSellUnit {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit     @relation(fields: [unitId], references: [id])
  conversionFactor Int
  sellingPrice     Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  @@unique([productId, unitId])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  createdAt DateTime @default(now())

  animals Animal[]
  sales   Sale[]
}

model Animal {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  species   String
  breed     String?
  birthDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  locationId String
  location   Location            @relation(fields: [locationId], references: [id])
  status     PurchaseOrderStatus @default(PENDING)
  orderDate  DateTime            @default(now())
  receivedAt DateTime?
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int @default(0)
  unitPrice        Decimal      @db.Decimal(10, 2)
}

model Sale {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  totalAmount   Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PAID)
  createdAt     DateTime      @default(now())

  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  items    SaleItem[]
  payments Payment[]
}

// Historique des règlements d'une vente : permet les paiements différés/partiels
// (ex. client sans porte-monnaie qui revient payer plus tard).
model Payment {
  id           String        @id @default(cuid())
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  cashReceived Decimal?      @db.Decimal(10, 2)
  note         String?
  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitLabel String
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
}

model StockMovement {
  id            String             @id @default(cuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id])
  locationId    String
  location      Location           @relation(fields: [locationId], references: [id])
  type          StockMovementType
  quantity      Int
  referenceType String?
  referenceId   String?
  note          String?
  productBatchId String?
  productBatch   ProductBatch?     @relation(fields: [productBatchId], references: [id])
  createdById   String
  createdBy     User               @relation(fields: [createdById], references: [id])
  createdAt     DateTime           @default(now())
}

// Déplacement de stock d'un emplacement vers un autre, tracé comme deux
// mouvements liés (TRANSFER_OUT à la source, TRANSFER_IN à la destination).
model StockTransfer {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  fromLocationId String
  fromLocation   Location @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location @relation("TransferTo", fields: [toLocationId], references: [id])
  quantity       Int
  note           String?
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
}

// Ligne unique (singleton, id fixe) : informations du cabinet affichées dans
// l'interface et sur les documents imprimés (bons de commande/réception).
model ClinicSettings {
  id              String   @id @default("singleton")
  name            String   @default("Univet MG")
  tagline         String?  @default("Cabinet vétérinaire — Gestion de stock & ventes")
  address         String?
  phone           String?
  email           String?
  expiryAlertDays Int      @default(90)
  slowMovingDays  Int      @default(30)
  updatedAt       DateTime @updatedAt
}

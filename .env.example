# PostgreSQL
POSTGRES_USER=univet
POSTGRES_PASSWORD=change_me
POSTGRES_DB=univet_mg
POSTGRES_PORT=5432

# Backend (Next.js API)
BACKEND_PORT=4000
DATABASE_URL=postgresql://univet:change_me@postgres:5432/univet_mg
JWT_SECRET=change_me_to_a_long_random_string

# Compte admin créé au premier seed (à changer après la première connexion)
SEED_ADMIN_EMAIL=admin@univet.mg
SEED_ADMIN_PASSWORD=Admin123!

# Frontend (Vite/React)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000

# Copier en .env sur l'environnement de production et remplacer TOUTES les valeurs.
# Générer des secrets forts avec : openssl rand -base64 32

# PostgreSQL
POSTGRES_USER=univet
POSTGRES_PASSWORD=CHANGEME_openssl_rand_-base64_24
POSTGRES_DB=univet_mg

# Backend (Next.js API)
DATABASE_URL=postgresql://univet:CHANGEME_meme_mot_de_passe_que_ci-dessus@postgres:5432/univet_mg
JWT_SECRET=CHANGEME_openssl_rand_-base64_48

# Domaines réels (HTTPS), configurés dans Dokploy pour les services frontend/backend
VITE_APP_ORIGIN=https://app.votredomaine.mg
VITE_API_URL=https://api.votredomaine.mg

# Compte admin créé au premier seed (à changer après la première connexion)
SEED_ADMIN_EMAIL=admin@univet.mg
SEED_ADMIN_PASSWORD=CHANGEME_mot_de_passe_fort
